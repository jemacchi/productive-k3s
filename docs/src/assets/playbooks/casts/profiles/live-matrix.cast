[92.194, "o", "[2026-08-31 21:20:48-0300] [STAGE:live-matrix] [2026-08-31 21:20:48-0300] ```\r\n"]
[92.234, "o", "[2026-08-31 21:20:48-0300] [STAGE:live-matrix] [2026-08-31 21:20:48-0300] echo https://rancher.k3s.lab.internal/dashboard/?setup=$(kubectl get secret --namespace cattle-system bootstrap-secret -o go-template='{{.data.bootstrapPassword|base64decode}}')\r\n"]
