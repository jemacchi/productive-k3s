[92.474, "o", "[2026-08-31 21:26:03-0300] [STAGE:live-matrix] [2026-08-31 21:26:03-0300] kubectl get secret --namespace cattle-system bootstrap-secret -o go-template='{{.data.bootstrapPassword|base64decode}}{{ \"\\n\" }}'\r\n"]
