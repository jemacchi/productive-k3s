[92.314, "o", "[2026-08-31 21:20:48-0300] [STAGE:live-matrix] [2026-08-31 21:20:48-0300]\r\n"]
[92.354, "o", "[2026-08-31 21:26:03-0300] [STAGE:live-matrix] [2026-08-31 21:26:03-0300] To get just the bootstrap password on its own, run:\r\n"]
