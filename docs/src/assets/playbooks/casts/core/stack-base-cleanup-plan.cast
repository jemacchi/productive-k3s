{"version": 2, "width": 80, "height": 24, "timestamp": 1787615197, "env": {"SHELL": "/bin/bash", "TERM": null}, "title": "core playbook: stack base cleanup plan"}
[0.0, "o", "$ ./productive-k3s-core.sh stack cleanup base --plan\r\n"]
[0.013, "o", "[ERROR] DESTRUCTIVE CLEANUP\r\n"]
[0.013, "o", "  This script is intended to remove the local productive-k3s-core stack completely.\r\n"]
[0.014, "o", "  It can uninstall k3s and delete cluster namespaces and local host integrations.\r\n"]
[0.014, "o", "  It does not try to preserve cluster state.\r\n"]
[0.014, "o", "  It does not remove arbitrary user files under storage paths, but Longhorn-backed data may become unreachable once the stack is removed.\r\n"]
[0.014, "o", "[INFO] Clean plan\r\n"]
[0.014, "o", "  - Uninstall k3s and remove local runtime state directories if present\r\n"]
[0.014, "o", "  - Delete namespace 'cert-manager' if present\r\n"]
[0.014, "o", "  - Delete namespace 'longhorn-system' if present\r\n"]
[0.014, "o", "  - Delete namespace 'cattle-system' if present\r\n"]
[0.014, "o", "  - Delete namespace 'cattle-fleet-system' if present\r\n"]
[0.014, "o", "  - Delete namespace 'cattle-fleet-local-system' if present\r\n"]
[0.014, "o", "  - Delete namespace 'cattle-capi-system' if present\r\n"]
[0.014, "o", "  - Delete namespace 'cattle-turtles-system' if present\r\n"]
[0.014, "o", "  - Delete namespace 'registry' if present\r\n"]
[0.014, "o", "  - Delete ClusterIssuer 'selfsigned' if present\r\n"]
[0.014, "o", "  - Delete ClusterIssuer 'letsencrypt-staging' if present\r\n"]
[0.014, "o", "  - Delete ClusterIssuer 'letsencrypt-production' if present\r\n"]
[0.014, "o", "  - Delete Rancher/Fleet/Turtles webhook configurations if present\r\n"]
[0.014, "o", "  - Delete cattle/fleet-related APIService and CRD objects if present\r\n"]
[0.014, "o", "  - Delete Longhorn StorageClasses, CSIDriver, and CRDs if present\r\n"]
[0.014, "o", "  - Remove NFS export '/srv/nfs/k8s-share' from /etc/exports and reload exports if present\r\n$ "]
