[33.95, "o", "## First Time Login\r\n"]
[34.09, "o", "\r\n"]
[34.23, "o", "If you provided your own bootstrap password during installation, browse to https://admin to get started.\r\n"]
[34.37, "o", "If this is the first time you installed Rancher, get started by running this command and clicking the URL it generates:\r\n"]
[34.51, "o", "\r\n"]
[34.65, "o", "```\r\n"]
[34.79, "o", "echo https://admin/dashboard/?setup=$(kubectl get secret --namespace cattle-system bootstrap-secret -o go-template='{{.data.bootstrapPassword|base64decode}}')\r\n"]
[34.93, "o", "```\r\n"]
[35.07, "o", "\r\n"]
[35.21, "o", "To get just the bootstrap password on its own, run:\r\n"]
[35.35, "o", "\r\n"]
[35.49, "o", "```\r\n"]
[35.63, "o", "kubectl get secret --namespace cattle-system bootstrap-secret -o go-template='{{.data.bootstrapPassword|base64decode}}{{ \"\\n\" }}'\r\n"]
