[0.0, "o", "$ bash -lc 'sudo k3s kubectl get storageclass && printf \"\\r\\n\" && ./utils/inspect-longhorn-volumes.sh && printf \"\\r\\n\" && sudo k3s kubectl get pvc -A && printf \"\\r\\n\" && ./utils/inspect-rancher.sh && printf \"\\r\\n\" && sudo k3s kubectl rollout status deploy/rancher -n cattle-system --timeout=60s'\r\n"]
